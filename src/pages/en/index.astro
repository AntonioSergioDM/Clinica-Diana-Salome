---
import { getEntry } from 'astro:content';
import ClinicSite from '../../components/ClinicSite.astro';
import type { SiteData } from '../../types/site';
import { englishSite } from '../../lib/localized-site';

const [portugueseEntry, englishEntry] = await Promise.all([
  getEntry('site', 'pt'),
  getEntry('site', 'en'),
]);
if (!portugueseEntry) throw new Error('Missing Portuguese site content.');
if (!englishEntry) throw new Error('Missing English site translations.');
const site = englishSite(
  portugueseEntry.data as unknown as SiteData,
  englishEntry.data as unknown as SiteData,
);
---

<ClinicSite site={site} lang="en" />
