---
import '../styles/site.scss';

interface Props {
  lang: 'pt' | 'en';
  title: string;
  description: string;
  siteUrl?: string;
  heroImage: string;
}

const { lang, title, description, siteUrl, heroImage } = Astro.props;
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : undefined;
const alternatePt = siteUrl ? new URL('/', siteUrl).toString() : undefined;
const alternateEn = siteUrl ? new URL('/en/', siteUrl).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
      try {
        const savedTheme = localStorage.getItem('site-theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : (systemPrefersDark ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf6f3" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {siteUrl && <meta property="og:image" content={new URL('/images/logo/logo2-social.png', siteUrl).toString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {alternatePt && <link rel="alternate" hreflang="pt-PT" href={alternatePt} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {alternatePt && <link rel="alternate" hreflang="x-default" href={alternatePt} />}
    <link rel="icon" href="/images/logo/favicon2.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/images/logo/favicon2-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/images/logo/favicon2-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/images/logo/apple-touch-icon2.png" />
    <link rel="manifest" href="/images/logo/site2.webmanifest" />
    <meta name="msapplication-config" content="/images/logo/browserconfig2.xml" />
    <link rel="preload" as="image" href={heroImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
